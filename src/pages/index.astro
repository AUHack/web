---
import Header from "../components/Header.astro";
import Navbar from "../components/Navbar.astro";
import ScheduleTable from "../components/ScheduleTable.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---


<BaseLayout title="Home">
	<Navbar leftItems={[
		{ name: "Schedule", href: "#schedule" },
		{ name: "Sponsors", href: "#sponsors" },
		{ name: "FAQ", href: "#faq" }
	]} />
	
	<Header
		title="AUHack 2026"
		subtitle="March 13th - 15th"
	/>

	<Section class="center">
		<strong class="text-lg">Sign-ups for this year's AUHack have closed.</strong>
	</Section>
	<Section>
	</Section>
	<Section>
		<SectionHeader>Schedule</SectionHeader>
	
		<ScheduleTable
			headline="Friday"
			items={[
				{time: "13:00 - 15:00", event: "Check-in", location: "Info stand"},
				{time: "13:00 - 15:30", event: "Bean bag toss w/ Knowit", location: "KnowIT"},
				{time: "13:30 - 15:30", event: "Coffee cart", location: "Café area"},
				{time: "15:15 - 16:00", event: "Opening ceremony", location: "Peter Bøgh Auditorium"},
				{time: "16:00 - 16:30", event: "Guest lecture starring Bjarne Stroustrup", location: "Peter Bøgh Auditorium"},
				{time: "16:30 - 17:00", event: "Case presentation", location: "Peter Bøgh Auditorium"},
				{time: "17:00 - 18:00", event: "Ideation & group formation", location: "Peter Bøgh Auditorium"},
				{time: "18:00 - 20:30", event: "Dinner", location: "Café area & Nygaard-basement"},
				{time: "18:00", event: "Hacking begins!", location: "Everywhere!"},
				{time: "18:00", event: "Robot minigolf begins!", location: "Info desk"},
				{time: "18:00", event: "Build a van Gogh", location: "Nygaard-basement"},
				{time: "19:30 - 20:30", event: "Functional programming workshop w/ InCommodities", location: "Nygaard-192"}
			]}
		/>
		<ScheduleTable
			headline="Saturday"
			items={[
				{time: "07:00 - 09:00", event: "Breakfast", location: "Café area"},
				{time: "09:00 - 10:00", event: "Yoga", location: "Nygaard-192"},
				{time: "10:00 - 11:55", event: "LEGO MASTERS w/ InCommodities", location: "Info desk"},
				{time: "12:00 - 15:00", event: "Masonic PC Gaming", location: "Nygaard-192"},
				{time: "13:00 - 14:30", event: "Lunch", location: "Café area"},
				{time: "16:00 - 16:45", event: "Playful Pitch Practice w/ CSG", location: "Peter Bøgh Auditorium"},
				{time: "18:00 - 19:30", event: "Dinner", location: "Café area"}
			]}
		/>
		<ScheduleTable
			headline="Sunday"
			items={[
				{time: "07:00 - 09:00", event: "Breakfast", location: "Café area"},
				{time: "11:00 - 12:00", event: "One Minute Madness", location: "Peter Bøgh Auditorium"},
				{time: "12:00 - 14:00", event: "Evaluation", location: "Nygaard-basement"},
				{time: "12:00 - 14:00", event: "Return hardware", location: "Hardware area"},
				{time: "12:00 - 14:30", event: "Lunch", location: "Café area"},
				{time: "14:00 - 14:30", event: "Clearing of group tables", location: "Nygaard-basement"},
				{time: "14:30 - 15:30", event: "Closing ceremony and prizes", location: "Peter Bøgh Auditorium"},
				{time: "15:30", event: "The end. Thanks for participating!", location: "Peter Bøgh Auditorium"}
			]}
		/>
	</Section>
</BaseLayout>
