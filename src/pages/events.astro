---
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Masonry from "../components/Masonry.astro";
import { show, eventsPage } from "../content/events.tsx";
import Event from "../components/Event.astro";

if (!show) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<BaseLayout
	pageTitle="Home"
	navbar={{
		leftItems: [
			{ name: "Info", href: "#info" },
			{ name: "Events", href: "#events" },
		],
	}}
	header={{ title: "AUHack 2026", subtitle: "Events Information" }}
>
	<Section color="white" id="info">
		<SectionHeader>AUHack 2026</SectionHeader>

		<p>
			For this year's AUHack, we will be having a ton of events! Here you are able to see what each of them are
			about, and whether you have to sign up to be able to participate in them. We hope there are some events here
			that catch your eye! How to sign up for events
		</p>
		<h4>How to Sign Up for Events</h4>
		<p>
			For every event that you have to sign up for, you have to go to the info stand and let an organizer know. If
			it's an event where you have to be a group, then tell the organizer your group number. If it's an event that
			is not for entire groups, then tell the organizer your name. If it is neither, then it says what you should
			do on the event itself below.
		</p>
	</Section>
	<Section color="orange" id="events">
		<SectionHeader>Events</SectionHeader>

		<Masonry>
			{
				eventsPage.map((event) => (
					<Event
						id={event.id}
						name={event.name}
						time={event.time}
						location={event.location}
						signup={event.signup}
					>
						{event.description}
					</Event>
				))
			}
		</Masonry>
	</Section>
</BaseLayout>
