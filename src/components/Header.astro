---
interface Props {
	title: string;
	subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<header>
	<div class="container">
		<h1>{title}</h1>
		<p>{subtitle}</p>
	</div>
</header>

<style>
	header {
		display: flex;
		align-items: center;

		background-image: url("/img/WebBanner.jpg");
		background-size: cover;
		background-position: center;

		height: 100vh;

		color: white;

		h1 {
			font-size: 10vh;
		}

		p {
			font-size: 5vh;
		}
	}
</style>
