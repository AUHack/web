---
interface Props {
    slot: string;
    ["as"]?: string;
}

const { slot: id, as: Tag = "article" } = Astro.props;
---

<Tag
    {...{
        id,
        ["data-tab-section"]: id,
    }}
>
    <slot />
</Tag>

<style>
    [data-tab-section] {
        display: none;
    }

    [data-tab-section].active {
        display: block;
    }
</style>