---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
    reverse?: boolean;
    color: 'orange' | 'white' | 'blue';
}

const { reverse = false, class: cl, color, ...rest } = Astro.props;
---

<section
    class:list={[reverse && "reverse", color]}
    {...rest}
>
    <slot name="outer" />
    <div class:list={["container", cl]}>
        <slot />
    </div>
</section>

<style>
    section.orange {
        --section-bg-color: var(--orange);
        --section-color: white;
        --figure-url: url("/img/figures/orange_bottom_right_triangle.svg");
        --reverse-figure-url: url("/img/figures/orange_bottom_left_triangle.svg");
    }

    section.white {
        --section-bg-color: white;
        --section-color: var(--blue-950);
        --figure-url: url("/img/figures/white_bottom_right_triangle.svg");
        --reverse-figure-url: url("/img/figures/white_bottom_left_triangle.svg");
    }

    section.blue {
        --section-bg-color: var(--blue-600);
        --section-color: white;
        --figure-url: url("/img/figures/gray_bottom_right_triangle.svg");
        --reverse-figure-url: url("/img/figures/gray_bottom_left_triangle.svg");
    }
    
    section {
        background-color: var(--section-bg-color);
        color: var(--section-color);
        padding-bottom: 8em;

        &::before {
            background-image: var(--figure-url);
            background-repeat: no-repeat;
            background-size: 100% 100%;
            display: block;
            position: relative;
            width: 100%;
            content: "";
            left: 0;
            top: -4em;
            height: 4em;
            z-index: 0;
        }

        &.reverse::before {
            background-image: var(--reverse-figure-url);
        }
    }
</style>

<style is:global>
    section.reverse > .container header {
        text-align: left;
    }
</style>