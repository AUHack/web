---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
    reverse?: boolean;
}

const { reverse = false, ...rest } = Astro.props;
---

<section class={reverse ? "reverse" : ""} {...rest}>
    <slot />
</section>

<style>
    section:nth-of-type(1) {
        --bg-color: #d65b12;
        --color: white;
        --figure-url: url("/img/figures/orange_bottom_right_triangle.svg");
        --reverse-figure-url: url("/img/figures/orange_bottom_left_triangle.svg");
    }

    section:nth-of-type(2) {
        --bg-color: white;
        --color: black;
        --figure-url: url("/img/figures/white_bottom_right_triangle.svg");
        --reverse-figure-url: url("/img/figures/white_bottom_left_triangle.svg");
    }

    section:nth-of-type(3) {
        --bg-color: #364759;
        --color: white;
        --figure-url: url("/img/figures/gray_bottom_right_triangle.svg");
        --reverse-figure-url: url("/img/figures/gray_bottom_left_triangle.svg");
    }
    
    section {
        background-color: var(--bg-color);
        color: var(--color);
        padding-bottom: 4em;

        &::before {
            background-image: var(--figure-url);
            background-repeat: no-repeat;
            background-size: 100% 100%;
            display: block;
            position: relative;
            width: 100%;
            content: "";
            left: 0;
            top: -4em;
            height: 4em;
        }

        &.reverse::before {
            background-image: var(--reverse-figure-url);
        }
    }
</style>
