---
interface Props {
    ["as"]?: string;
}

const { as = "h2" } = Astro.props;
const Tag = as;
---

<header>
    <Tag><slot /></Tag>
    <hr>
    <slot name="subtitle" />
</header>

<style>
    header {
        width: 100%;
        text-align: right; /* If the is places inside a reverse section, the text-align will be flipped */
        margin-bottom: 3.25rem;

        h1, h2, h3, h4, h5, h6 {
            font-size: 3.5rem;
            text-transform: uppercase;
        }

        hr {
            color: inherit;
        }
    }
</style>