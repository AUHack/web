---
interface Props {
    ["as"]?: string;
}

const { as = "h2" } = Astro.props;
const Tag = as;
---

<header>
    <Tag><slot /></Tag>
    <hr>
</header>

<style>
    header {
        width: 100%;
        text-align: right; /* If the is places inside a reverse section, the text-align will be flipped */

        *:not(hr) {
            font-size: 3.5rem;
            text-transform: uppercase;
        }

        hr {
            margin-bottom: 3.25rem;
            color: inherit;
        }
    }
</style>