---
interface Props {
	align?: "left" | "center" | "right";
	["as"]?: string;
}

const { as = "h2", align } = Astro.props;
const Tag = as;
---

<header class:list={[align]}>
	<Tag class:list={["headline"]}><slot /></Tag>
	<hr />
	<slot name="subtitle" />
</header>

<style>
	header {
		width: 100%;
		text-align: right; /* If the is places inside a reverse section, the text-align will be flipped */
		margin-bottom: 3.25rem;

		&.left {
			text-align: left;
		}

		&.center {
			text-align: center;
		}

		&.right {
			text-align: right;
		}

		.headline {
			font-size: 3.5rem;
			text-transform: uppercase;

			&:target {
				scroll-margin-top: 128px;
			}
		}

		hr {
			color: inherit;
		}
	}
</style>
