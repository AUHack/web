---
import Section from "./Section.astro";
import EnvelopeFill from "./Icons/envelope-fill.svg";
import FacebookIcon from "./Icons/facebook.svg";
import LinkedInIcon from "./Icons/linkedin.svg";

const year = new Date().getFullYear();
---

<Section as="footer" color="blue" reverse id="footer">
    <h3>Contact</h3>

    <ul class="contacts">
        <li>
            <a href="mailto:contact@auhack.org">
                <EnvelopeFill />
            </a>
        </li>
        <li>
            <a href="https://www.facebook.com/AUHack">
                <FacebookIcon />
            </a>
        </li>
        <li>
            <a href="https://www.linkedin.com/company/auhack/">
                <LinkedInIcon />
            </a>
        </li>
    </ul>

    <hr>

    <p>
        AUHack © 2016-{year} | <a href="mailto:contact@auhack.org">contact@auhack.org</a> | <a href="/code-of-conduct">Code of Conduct</a>
        <br>
        Made with ❤️ by real humans at the AUHack Team.
    </p>
</Section>


<style>
    .contacts {
        display: flex;
        gap: 2rem;
        list-style: none;
        color: inherit;
        text-decoration: none;
        
        svg {
            width: 64px;
            height: 64px;
            
            &:hover {
                transform: scale(1.1);
            }
        }
    }

    hr {
        width: 100%;
        color: currentColor;
        margin: 0;
    }

    .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        text-align: center;
    }

    footer.section {
        padding-bottom: 4rem;
    }
</style>