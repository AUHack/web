mixin add_evaluation_plan(case_name, ...rows)
    .row: .col-sm-12
        h4= case_name
        table(class="table")
            thead
                tr
                    th(style="width: 15%") Evaluation number
                    th(style="width: 20%") Group number
                    th(style="width: 25%") Group name
                    th(style="width: 20%") Evaluation start
                    th(style="width: 20%") Evaluation end
            tbody
                each item in rows
                    tr
                        td=item.evalnum
                        td=item.groupnum
                        td=item.groupname
                        td=item.evalstart
                        td=item.evalend

section.evaluationplan-section#evaluationplan-section(class="triangle"): .container: .row: .col-sm-12
